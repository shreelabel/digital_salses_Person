# =============================================================
# SLC AI Sales Agent — Environment Configuration (TEMPLATE)
# Copy this file to ".env" and fill in your values.
# IMPORTANT: This file is ONLY for the standalone slc_ai_sales DB.
# NEVER point this app at the Shree Label Creation ERP database.
# =============================================================

# ---------- Database (ONLY slc_ai_sales — never the ERP) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=slc_ai_sales
DB_USER=root
DB_PASS=

# ---------- Application ----------
APP_NAME=SLC AI Sales Agent
APP_ENV=production
APP_DEBUG=false
# Path under htdocs where the project lives, e.g. /slc-ai-sales
# Leave EMPTY if installed at the web root. No trailing slash.
APP_BASE_PATH=

# ---------- Security ----------
# Replace with a long random string (>= 32 chars) in production.
APP_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Session lifetime in seconds (7200 = 2 hours of inactivity window)
SESSION_LIFETIME=7200
# Brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# ---------- Gemini AI (SERVER-SIDE ONLY — never sent to browser) ----------
# Gemini is now OPTIONAL (free-first system). Discovery uses Hunter/Apollo and
# AI uses FreeLLMAPI -> 9Router, with Gemini only as a last AI fallback.
# Provider API keys are managed in AI Settings (stored encrypted in the DB).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# ---------- Providers (configured via the AI Settings UI; keys encrypted in DB) ----------
HUNTER_API_KEY=
APOLLO_API_KEY=
FREELLMAPI_API_KEY=
NINEROUTER_API_KEY=
FREELLMAPI_BASE_URL=https://api.freellmapis.com/v1
NINEROUTER_BASE_URL=https://api.9router.com/v1
